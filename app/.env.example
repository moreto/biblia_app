# Copie para app/.env (fica fora do git) e preencha só o que precisar.
# Lido no build com --dart-define-from-file=.env (já configurado no .vscode/launch.json).
# Depois de mudar, reinicie o app (hot reload não relê o .env).

# Rota em que o app abre no lugar da /home. Vazia abre a home.
# continuar: abre a leitura no último capítulo aberto ("Continuar de onde parou"); sem capítulo guardado, a home.
# Exemplos: /biblia-leitura, /dashboard, /comunidade, /biblia-leitura?versaId=1&livrId=43&capiNumero=3
# Rotas da área logada sem login voltam para a /home.
ROTA_INICIAL=
